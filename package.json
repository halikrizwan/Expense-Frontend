{
  "name": "Expenses",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "ANDROID_HOME=$HOME/Library/Android/sdk ANDROID_SDK_ROOT=$HOME/Library/Android/sdk react-native run-android --no-packager",
    "ios": "react-native run-ios --no-packager",
    "pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 bundle exec pod install",
    "lint": "eslint .",
    "start": "react-native start",
    "start:device": "react-native start --host 0.0.0.0",
    "kill:metro": "lsof -ti:8081 | xargs kill -9 2>/dev/null; lsof -ti:8082 | xargs kill -9 2>/dev/null; echo 'Cleared ports 8081 and 8082'",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "dayjs": "^1.11.19",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-document-scanner-plugin": "^1.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-native-share": "^12.2.5",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.7.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
